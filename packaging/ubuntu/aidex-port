#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then exec sudo "$0" "$@"; fi
. /usr/lib/aidex/profile.sh
aidex_select_profile
if [ ! -f "$CONFIG" ]; then echo 'Primero configura AIDEX.' >&2; exit 1; fi
old_address=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["listen_address"])' "$CONFIG")
old_port=${old_address##*:}
printf 'Puerto actual de AIDEX: %s\n' "$old_port"
new_port=${1-}
if [ -z "$new_port" ]; then printf 'Nuevo puerto TCP (Enter para cancelar): '; IFS= read -r new_port; fi
[ -n "$new_port" ] || exit 0
case $new_port in *[!0-9]*|'') echo 'Introduce un puerto entre 1 y 65535.' >&2; exit 1;; esac
[ "$new_port" -ge 1 ] && [ "$new_port" -le 65535 ] || { echo 'Puerto fuera de intervalo.' >&2; exit 1; }
[ "$new_port" != "$old_port" ] || { echo 'El puerto ya está configurado.'; exit 0; }
was_running=0
if systemctl is-active --quiet "$UNIT"; then was_running=1; systemctl stop "$UNIT"; fi
if ! runuser -u "$ACCOUNT" -- "$BINARY" configure-port --config "$CONFIG" --port "$new_port"; then
    [ "$was_running" -eq 0 ] || systemctl start "$UNIT"
    exit 1
fi
if [ "$was_running" -eq 1 ]; then
    ready=0
    if systemctl start "$UNIT"; then
        attempt=0
        while [ "$attempt" -lt 30 ]; do
            if python3 -c 'import sys,urllib.request; urllib.request.urlopen("http://127.0.0.1:%s/health/live"%sys.argv[1],timeout=1).close()' "$new_port" >/dev/null 2>&1; then ready=1; break; fi
            attempt=$((attempt + 1))
            sleep 1
        done
    fi
    if [ "$ready" -ne 1 ]; then
        echo 'El servicio no respondió. Restaurando el puerto anterior.' >&2
        systemctl stop "$UNIT" || true
        runuser -u "$ACCOUNT" -- "$BINARY" configure-port --config "$CONFIG" --port "$old_port"
        systemctl start "$UNIT"
        exit 1
    fi
fi
printf 'AIDEX configurado en http://127.0.0.1:%s\n' "$new_port"
