#!/bin/sh
set -eu
# Restrict upgrades to the tested preview path; postinst migrates with the new
# binary (including its SQLite snapshot) before publishing the version marker.
if [ -f /var/lib/aibid-test/package-version ]; then
    case "$(cat /var/lib/aibid-test/package-version)" in
        '0.7.0-test.1'|'2.0.0-alpha.1'|'2.0.0-alpha.2'|'@VERSION@') ;;
        *) echo 'Versión de datos no compatible con esta fase. Se conservan los datos.' >&2; exit 1 ;;
    esac
fi
for path in /var/lib/aibid-test /etc/aibid-test /etc/aibid-test/config.json; do
    [ ! -L "$path" ] || exit 1
done
if [ -d /run/systemd/system ] && systemctl is-active --quiet aibid-test.service; then systemctl stop aibid-test.service; fi
if [ -f /etc/aibid-test/config.json ] && [ -x /usr/lib/aibid-test/gestor-documental ]; then
    runuser -u aibid-test -- /usr/lib/aibid-test/gestor-documental migrate --config /etc/aibid-test/config.json
fi
