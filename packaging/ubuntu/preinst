#!/bin/sh
set -eu
@PROFILE@
aidex_select_profile
if [ -f "$DATA/package-version" ]; then
    case "$(cat "$DATA/package-version")" in
        '@VERSION@') ;;
        *) echo 'Versión de datos no compatible. Se conservan los datos.' >&2; exit 1 ;;
    esac
fi
if [ -f "$CONFIG" ] && [ ! -f "$DATA/package-version" ]; then
    echo 'Configuración existente sin versión de paquete. Requiere revisión.' >&2; exit 1
fi
if [ -d /run/systemd/system ]; then
    if systemctl is-active --quiet "$UNIT"; then systemctl stop "$UNIT"; fi
fi
# Do not migrate using the old binary. Postinst uses the new checker and migration.
