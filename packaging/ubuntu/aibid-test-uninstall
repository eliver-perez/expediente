#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then exec sudo "$0"; fi
ERASE=no
echo 'Por defecto se conservarán los datos de AIBID.'
printf '¿Eliminar base de datos, índices, texto extraído y configuración? [s/N]: '
read -r ANSWER || ANSWER=no
case "$ANSWER" in
    s|S|si|sí)
        echo 'Se perderán usuarios, bibliotecas registradas, historial y activación local.'
        echo 'Todos los documentos físicos, incluidas cargas privadas, permanecerán intactos.'
        printf 'Escribe ELIMINAR para confirmar: '
        read -r ANSWER || ANSWER=no
        [ "$ANSWER" != ELIMINAR ] || ERASE=yes ;;
esac
systemctl stop aibid-test.service
if [ -f /etc/aibid-test/config.json ]; then
    /usr/lib/aibid-test/gestor-documental check-state --config /etc/aibid-test/config.json
    if [ "$ERASE" = yes ]; then
        /usr/lib/aibid-test/gestor-documental erase-internal-data --config /etc/aibid-test/config.json --confirm-erase-internal-data
        # Ubuntu stores these package-owned markers next to state, while the
        # configuration is in /etc. Leave all other files and directories intact.
        rm -f /var/lib/aibid-test/service-enabled /var/lib/aibid-test/package-version
    fi
fi
apt-get remove aibid-test
