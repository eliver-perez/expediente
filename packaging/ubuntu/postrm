#!/bin/sh
set -eu
if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
# Even purge preserves documents, database, private identity, configuration and account.
if [ -f /etc/aibid-test/config.json ]; then
    echo 'Datos y configuración conservados en /var/lib/aibid-test y /etc/aibid-test.'
else
    echo 'Documentos físicos conservados. No se han recorrido las bibliotecas.'
fi
