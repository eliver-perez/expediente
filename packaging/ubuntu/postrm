#!/bin/sh
set -eu
if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database /usr/share/applications; fi
# Even purge preserves documents, database, private identity, configuration and account.
echo 'Datos y configuración de AIDEX conservados. No se han recorrido las bibliotecas.'
