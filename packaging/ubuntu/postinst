#!/bin/sh
set -eu
umask 077
. /usr/lib/aidex/profile.sh
aidex_select_profile
if [ "$1" = configure ]; then
    if ! getent passwd "$ACCOUNT" >/dev/null; then
        adduser --system --group --home "$DATA" --no-create-home --disabled-login "$ACCOUNT"
    fi
    [ "$(getent passwd "$ACCOUNT" | cut -d: -f6)" = "$DATA" ] || exit 1
    [ "$(getent passwd "$ACCOUNT" | cut -d: -f7)" = /usr/sbin/nologin ] || exit 1
    install -d -o "$ACCOUNT" -g "$ACCOUNT" -m 700 "$DATA" "$CONFIG_DIR"
    if [ ! -e "$CONFIG" ]; then
        runuser -u "$ACCOUNT" -- "$BINARY" init --config "$CONFIG" --state "$DATA/state" --listen 127.0.0.1:18090 --tools /usr/bin
    fi
    runuser -u "$ACCOUNT" -- "$BINARY" check-state --config "$CONFIG"
    runuser -u "$ACCOUNT" -- "$BINARY" configure-license --config "$CONFIG"
    runuser -u "$ACCOUNT" -- "$BINARY" migrate --config "$CONFIG"
    printf '%s\n' '@VERSION@' > "$DATA/package-version"
    chown "$ACCOUNT:$ACCOUNT" "$DATA/package-version"
    chmod 600 "$DATA/package-version"
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        if [ -f "$DATA/service-enabled" ]; then
            systemctl enable --now "$UNIT"
            systemctl is-active --quiet "$UNIT"
            port=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["listen_address"].rsplit(":",1)[1])' "$CONFIG")
            attempt=0
            while [ "$attempt" -lt 30 ]; do
                if python3 -c 'import json,sys,urllib.request; sys.exit(0 if json.load(urllib.request.urlopen("http://127.0.0.1:%s/health/live"%sys.argv[1],timeout=1)).get("product")=="AIDEX" else 1)' "$port" >/dev/null 2>&1; then break; fi
                attempt=$((attempt + 1))
                sleep 1
            done
            [ "$attempt" -lt 30 ] || { echo "AIDEX no respondió en el puerto $port. Se conservaron los datos; revisa journalctl -u aidex.service." >&2; exit 1; }
        fi
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then update-desktop-database /usr/share/applications; fi
    echo 'Instalado AIDEX. Ejecuta sudo aidex-admin para crear el administrador e iniciar el servicio.'
fi
