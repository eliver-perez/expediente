#!/bin/sh
set -eu
. /usr/lib/aidex/profile.sh
aidex_select_profile
if [ -d /run/systemd/system ]; then
    if systemctl is-active --quiet "$UNIT"; then systemctl stop "$UNIT"; fi
    if [ "$1" = remove ]; then systemctl disable "$UNIT"; fi
fi
if [ -f "$CONFIG" ]; then
    runuser -u "$ACCOUNT" -- "$BINARY" check-state --config "$CONFIG"
fi
