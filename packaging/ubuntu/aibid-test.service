[Unit]
Description=AIBID Pruebas — biblioteca digital
After=network.target
ConditionPathExists=/var/lib/aibid-test/service-enabled

[Service]
Type=simple
User=aibid-test
Group=aibid-test
ExecStart=/usr/lib/aibid-test/gestor-documental serve --config /etc/aibid-test/config.json
WorkingDirectory=/var/lib/aibid-test
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
