#!/bin/sh
set -eu
[ "$(id -u)" -eq 0 ] || { echo 'Ejecuta sudo aidex-admin' >&2; exit 1; }
. /usr/lib/aidex/profile.sh
aidex_select_profile
runuser -u "$ACCOUNT" -- "$BINARY" doctor --config "$CONFIG" --sample-directory /usr/share/doc/aidex/pdf
if ! runuser -u "$ACCOUNT" -- "$BINARY" bootstrap-ready --config "$CONFIG" >/dev/null 2>&1; then
    runuser -u "$ACCOUNT" -- "$BINARY" bootstrap --config "$CONFIG"
fi
if [ ! -f "$DATA/service-enabled" ]; then
    runuser -u "$ACCOUNT" -- touch "$DATA/service-enabled"
fi
systemctl enable --now "$UNIT"
systemctl is-active --quiet "$UNIT"
port=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="utf-8"))["listen_address"].rsplit(":",1)[1])' "$CONFIG")
attempt=0
while [ "$attempt" -lt 30 ]; do
    if python3 -c 'import json,sys,urllib.request; sys.exit(0 if json.load(urllib.request.urlopen("http://127.0.0.1:%s/health/live"%sys.argv[1],timeout=1)).get("product")=="AIDEX" else 1)' "$port" >/dev/null 2>&1; then break; fi
    attempt=$((attempt + 1))
    sleep 1
done
[ "$attempt" -lt 30 ] || { echo "El servicio no respondió en el puerto $port. Revisa journalctl -u aidex.service." >&2; exit 1; }
echo "AIDEX disponible en http://127.0.0.1:$port (en este equipo)."
