#!/bin/sh
set -eu
. "$(dirname "$0")/profile.sh"
aidex_select_profile
if [ -f "$BASE/data/package-version" ]; then
    case "$(cat "$BASE/data/package-version")" in
        '@VERSION@') ;;
        *) echo 'Versión de datos no compatible con este instalador. Se conservan los datos.' >&2; exit 1 ;;
    esac
fi
if [ -L "$BASE" ] || [ -L "$BASE/data" ] || [ -L "$BASE/data/config.json" ]; then
    echo 'La ruta de instalación no puede ser un enlace.' >&2
    exit 1
fi
if [ -f "$CONFIG" ] && [ ! -f "$BASE/data/package-version" ]; then
    echo 'Configuración existente sin versión de paquete. Requiere revisión.' >&2; exit 1
fi
if /bin/launchctl print system/app.aidex >/dev/null 2>&1; then
    /bin/launchctl bootout system/app.aidex
fi
# Updates use the newly installed binary for check-state and migration.
